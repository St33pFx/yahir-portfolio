---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyPage from '../../../components/CaseStudyPage';
import { getAllProjects, getProjectBySlug } from '../../../data/projects';

export function getStaticPaths() {
  return getAllProjects()
    .filter((project) => project.caseStudy?.es?.overview)
    .map((project) => ({ params: { slug: project.slug }, props: { slug: project.slug } }));
}

const { slug } = Astro.props;
const project = getProjectBySlug(slug);

const pageTitle = project
  ? `${project.name} — ${project.category} | JozeDzn`
  : 'Trabajo | JozeDzn';

const overviewText = project?.caseStudy?.es?.overview || '';
const pageDesc = overviewText
  ? overviewText.slice(0, 155) + (overviewText.length > 155 ? '…' : '')
  : `${project?.name} — proyecto de ${project?.category} por JozeDzn.`;

const pageImage = project?.socialImage || project?.image
  ? (project.socialImage || project.image)
  : project?.vimeoId
    ? `https://vumbnail.com/${project.vimeoId}.jpg`
    : undefined;

const breadcrumbSchema = project ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://jozedzn.com/es/' },
    { '@type': 'ListItem', position: 2, name: 'Trabajo', item: 'https://jozedzn.com/es/#work' },
    { '@type': 'ListItem', position: 3, name: project.name, item: `https://jozedzn.com/es/work/${slug}` },
  ],
} : null;

const creativeWorkSchema = project ? {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  inLanguage: 'es-MX',
  name: project.name,
  description: pageDesc,
  url: `https://jozedzn.com/es/work/${slug}`,
  dateCreated: project.year,
  creator: { '@type': 'Person', name: 'JozeDzn', url: 'https://jozedzn.com' },
  genre: project.category,
  keywords: project.tags?.join(', '),
} : null;

const jsonLd = [breadcrumbSchema, creativeWorkSchema].filter(Boolean);
---
<BaseLayout
  lang="es"
  title={pageTitle}
  description={pageDesc}
  canonicalPath={`/es/work/${slug}`}
  alternateEnPath={`/work/${slug}`}
  alternateEsPath={`/es/work/${slug}`}
  ogImage={pageImage}
  ogImageAlt={`${project?.name || 'Proyecto'} — caso de estudio de JozeDzn`}
  jsonLd={jsonLd}
>
  <CaseStudyPage slug={slug} initialLang="es" client:load />
</BaseLayout>
